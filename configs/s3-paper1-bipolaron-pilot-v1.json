{
  "schema_version": 1,
  "campaign_id": "s3-paper1-bipolaron-pilot-v1",
  "stage": "pilot",
  "lattice_sizes": [8],
  "model": {
    "geometry": "bandwidth-matched isotropic square",
    "boundary_conditions": "periodic",
    "Jx_eV": 0.0575,
    "Jy_eV": 0.0575,
    "K1_eV_per_A2": 16.51,
    "K2_eV_per_A2": 0.51,
    "base_alpha_intra_eV_per_A": 3.0,
    "base_alpha_x_eV_per_A": 0.1,
    "base_alpha_y_eV_per_A": 0.1,
    "coupling_scale_definition": "global multiplier applied to alpha_intra, alpha_x, and alpha_y",
    "interaction": "onsite U plus isotropic nearest-neighbour V1",
    "long_range_coulomb": false
  },
  "grid": {
    "U_eV": [0.525, 1.0],
    "V1_eV": [0.0, 0.016, 0.32],
    "coupling_scale": [0.8, 1.0]
  },
  "branches": ["onsite", "intersite_x", "intersite_y", "diagonal", "separated"],
  "numerical": {
    "max_iterations": 1200,
    "coordinate_update_tolerance_A": 1e-8,
    "gradient_tolerance_eV_per_A": 1e-6,
    "eigensolver_tolerance": 1e-11,
    "thread_count": 1
  },
  "classification": {
    "energy_tie_tolerance_eV": 1e-8,
    "robust_binding_threshold_eV": 0.005,
    "linear_peierls_ratio_max": 0.25
  },
  "finite_size_policy": {
    "production_size": 20,
    "boundary_validation_size": 40,
    "pilot_is_not_paper_data": true
  }
}
